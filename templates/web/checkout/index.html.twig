{% extends 'web/layout.html.twig' %}

{% block title %}Оформление заказа · Ganesha{% endblock %}

{% block seo_description %}Оформление предзаказа вегетарианского питания Ganesha.{% endblock %}
{% block seo_robots %}noindex,nofollow{% endblock %}

{% block head %}
    <script>
        window.__GANESHA_CHECKOUT_CART__ = {{ cart.groups|json_encode|raw }};
        window.__GANESHA_CHECKOUT_OPTIONS__ = {
            cartFieldId: {{ form.cartGroupsJson.vars.id|json_encode|raw }},
            homeUrl: {{ path('web_home')|json_encode|raw }},
        };
    </script>
{% endblock %}

{% block body %}
    <div class="container py-4 py-lg-5"
         x-data="ganeshaCheckoutSummary(window.__GANESHA_CHECKOUT_CART__ || [], window.__GANESHA_CHECKOUT_OPTIONS__ || {})">
        <div class="row g-4 g-lg-5 justify-content-center">
            <div class="col-lg-5">
                <div class="site-panel site-checkout-summary h-100">
                    <p class="site-checkout-summary__eyebrow mb-2">Ваш заказ</p>
                    <h1 class="h3 mb-1" x-text="dayCountLabel()"></h1>

                    <template x-for="(group, groupIndex) in groups" :key="group.pickup_date">
                        <section class="site-checkout-day" :class="{ 'mb-4': groupIndex < groups.length - 1 }">
                            <p class="site-checkout-summary__date mb-3" x-text="formatDayLabel(group.pickup_date)"></p>

                            <ul class="site-checkout-list mb-0">
                                <template x-for="item in group.items" :key="group.pickup_date + '-' + item.menu_day_dish_id">
                                    <li class="site-checkout-list__row">
                                        <span class="site-checkout-list__name" x-text="item.name + ' × ' + item.quantity"></span>
                                        <strong class="site-checkout-list__price" x-text="formatRub(item.price * item.quantity)"></strong>
                                        <button type="button"
                                                class="site-checkout-list__remove"
                                                @click="removeItem(group.pickup_date, item.menu_day_dish_id)"
                                                aria-label="Убрать из заказа"
                                                title="Убрать">×</button>
                                    </li>
                                </template>
                            </ul>
                        </section>
                    </template>

                    <div class="site-checkout-total d-flex justify-content-between align-items-center mt-4">
                        <span>Итого</span>
                        <strong class="site-checkout-total__amount" x-text="formatRub(cartTotalKopecks())"></strong>
                    </div>

                    <p class="site-checkout-summary__hint small text-muted mt-4 mb-0"
                       x-show="groups.length > 1"
                       x-cloak
                       x-text="'Будет создано ' + orderCountLabel() + ' — по одному на каждый день. Оплата одним переводом на общую сумму.'"></p>
                    <p class="site-checkout-summary__hint small text-muted mt-4 mb-0"
                       x-show="groups.length === 1"
                       x-cloak>
                        После подтверждения вы перейдёте к оплате. Корзина сохранится, если вернётесь к меню.
                    </p>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="site-panel">
                    <h2 class="h4 mb-1">Контактные данные</h2>
                    <p class="text-muted mb-4">Телефон обязателен — напишем, если что-то уточнить.</p>

                    {% form_theme form 'form/site_bootstrap.html.twig' %}

                    {{ form_start(form, { attr: { class: 'site-form site-form--checkout' } }) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(form.phone, {
                                    label: 'Телефон *',
                                    attr: { class: 'form-control form-control-lg', placeholder: '+7 912 345-67-89' },
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.name, {
                                    attr: { class: 'form-control form-control-lg', placeholder: 'Как к вам обращаться' },
                                }) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.pickupPointId, {
                                    attr: { class: 'form-select form-select-lg' },
                                }) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.comment, {
                                    attr: { class: 'form-control', rows: 3, placeholder: 'Например: без лука' },
                                }) }}
                            </div>
                            <div class="col-12">
                                <div class="form-check site-form-check">
                                    {{ form_widget(form.personalDataConsent) }}
                                    <label class="form-check-label" for="{{ form.personalDataConsent.vars.id }}">
                                        Согласен(на) на обработку персональных данных —
                                        <a href="{{ privacy_policy_url }}" target="_blank" rel="noopener">политика конфиденциальности</a>
                                    </label>
                                </div>
                                {{ form_errors(form.personalDataConsent) }}
                            </div>
                        </div>

                        {{ form_rest(form) }}

                        <div class="site-form-actions">
                            <button type="submit" class="btn btn-primary site-btn-primary">
                                <span x-show="groups.length > 1" x-text="'Подтвердить ' + orderCountLabel()"></span>
                                <span x-show="groups.length <= 1">Подтвердить заказ</span>
                            </button>
                            <a href="{{ path('web_home') }}" class="btn btn-outline-secondary site-btn-outline">
                                Вернуться к меню
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
