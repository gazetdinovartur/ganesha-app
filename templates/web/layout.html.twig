<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#3d6b4f">
    <title>{% block title %}Ganesha · питание{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="{{ asset('css/site.css') }}" rel="stylesheet">
    {% block head %}{% endblock %}
</head>
<body class="site-body">
    <header class="site-header">
        <div class="container site-header__inner">
            <a class="site-brand" href="{{ path('web_home') }}">
                <span class="site-brand__mark" aria-hidden="true">🌿</span>
                <span class="site-brand__text">
                    <strong>Ganesha</strong>
                    <small>вегетарианское питание</small>
                </span>
            </a>
            <nav class="site-nav" aria-label="Основная навигация">
                <a class="site-nav__link{% if app.request.attributes.get('_route') == 'web_home' %} is-active{% endif %}" href="{{ path('web_home') }}">Меню</a>
                <a class="site-nav__link{% if app.request.attributes.get('_route') == 'web_about' %} is-active{% endif %}" href="{{ path('web_about') }}">О нас</a>
            </nav>
        </div>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show site-alert" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <main class="site-main">
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p class="mb-1">Самовывоз в центре йоги «Хануман», Екатеринбург</p>
            <p class="site-footer__muted mb-0">Заказ на завтра — до 18:00 сегодня</p>
        </div>
    </footer>

    {% include 'web/_partials/cart_bar.html.twig' %}

    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdtKa0uQAxMVb9n" crossorigin="anonymous"></script>
    <script src="{{ asset('js/site.js') }}"></script>
    {% block javascripts %}{% endblock %}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</body>
</html>
