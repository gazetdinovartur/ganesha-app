# Скопируй в .env.local и заполни секреты. Подробно: docs/go-live.md

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_random_string
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Локально с Docker: порт 3307 на хосте
DATABASE_URL="mysql://food:food@127.0.0.1:3307/food?serverVersion=8.0&charset=utf8mb4"
# Внутри docker compose (php-контейнер):
# DATABASE_URL="mysql://food:food@mysql:3306/food?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
APP_TIMEZONE=Asia/Yekaterinburg
ORDER_CUTOFF_HOUR=18
ORDER_MENU_HORIZON_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

TELEGRAM_BOT_TOKEN=  # @BotFather → docs/go-live.md §3
TELEGRAM_ADMIN_CHAT_ID=  # chat id админа для алертов

VK_GROUP_TOKEN=  # Ключ сообщества VK → docs/go-live.md §4
VK_CONFIRMATION_SECRET=  # Строка подтверждения Callback API

PRIVACY_POLICY_URL=http://localhost:8080/privacy  # страница /privacy; app:seed:privacy проставит из DEFAULT_URI

PAYMENT_QR_URL=  # URL картинки QR СБП → docs/go-live.md §5
PAYMENT_CARD=  # Карта / телефон СБП для копирования
PAYMENT_WEBHOOK_SECRET=change_me  # openssl rand -hex 24
SBER_WEBHOOK_SECRET=  # X-Sber-Webhook-Secret на /api/payment/sber/webhook
YOOKASSA_WEBHOOK_SECRET=
###< app ###
