{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Меню недели{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_menu_week', {start: prevStart.format('Y-m-d')}) }}" class="btn btn-secondary btn-sm">← Неделя</a>
    <a href="{{ path('admin_menu_week', {start: nextStart.format('Y-m-d')}) }}" class="btn btn-secondary btn-sm">Неделя →</a>
{% endblock %}

{% block main %}
    <p class="text-muted mb-3">С {{ start.format('d.m.Y') }} · до 7 дней</p>

    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Дата</th>
            <th>Опубликован</th>
            <th>Позиций</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for day in days %}
            <tr>
                <td>{{ day.date.format('D, d.m.Y') }}</td>
                <td>
                    {% if day.isPublished %}
                        <span class="badge text-bg-success">да</span>
                    {% else %}
                        <span class="badge text-bg-secondary">нет</span>
                    {% endif %}
                </td>
                <td>{{ day.dishes|length }}</td>
                <td class="text-end">
                    <a href="{{ path('admin_menu_day_edit', {id: day.id}) }}" class="btn btn-sm btn-primary">Редактировать</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
