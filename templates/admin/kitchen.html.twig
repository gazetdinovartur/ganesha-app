{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
    Кухня ·
    {% if viewMode == 'week' %}
        {{ weekStart.format('d.m') }}–{{ weekEnd.format('d.m.Y') }}
    {% else %}
        {{ date.format('d.m.Y') }}
    {% endif %}
{% endblock %}

{% block main %}
    {% set hasOrders = orders|length > 0 %}
    {% set isTomorrowView = viewMode == 'day' and date.format('Y-m-d') == tomorrow.format('Y-m-d') %}

    <form method="get" class="kitchen-filter-form d-flex flex-wrap align-items-end gap-2 mb-4">
        <div>
            <label class="form-label" for="date">Дата</label>
            <input type="date"
                   class="form-control"
                   id="date"
                   name="date"
                   value="{{ viewMode == 'day' ? date.format('Y-m-d') : today.format('Y-m-d') }}">
        </div>
        <div>
            <button class="btn btn-secondary" type="submit">Показать</button>
        </div>
        <div class="kitchen-range-nav ms-auto">
            <a href="{{ path('admin_kitchen', { date: tomorrow.format('Y-m-d') }) }}"
               class="kitchen-range-btn{{ isTomorrowView ? ' is-active' : '' }}">
                На завтра
            </a>
            <a href="{{ path('admin_kitchen', { range: 'week' }) }}"
               class="kitchen-range-btn{{ viewMode == 'week' ? ' is-active' : '' }}">
                На неделю
            </a>
        </div>
    </form>

    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="h6">
                Сводка (все заказы)
                {% if viewMode == 'week' %}
                    <span class="text-muted fw-normal">· неделя</span>
                {% endif %}
            </h2>
            {% if summaryAll %}
                <ul class="list-group list-group-flush">
                    {% for name, qty in summaryAll %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ name }}</span><strong>{{ qty }}</strong>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Нет заказов.</p>
            {% endif %}
        </div>
        <div class="col-md-6">
            <h2 class="h6">
                Сводка (оплаченные)
                {% if viewMode == 'week' %}
                    <span class="text-muted fw-normal">· неделя</span>
                {% endif %}
            </h2>
            {% if summaryPaid %}
                <ul class="list-group list-group-flush">
                    {% for name, qty in summaryPaid %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ name }}</span><strong>{{ qty }}</strong>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Нет оплаченных.</p>
            {% endif %}
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('kitchen_batch') }}">
        <input type="hidden" name="date" value="{{ date.format('Y-m-d') }}">
        {% if viewMode == 'week' %}
            <input type="hidden" name="range" value="week">
        {% endif %}

        {% if hasOrders %}
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button name="batch_action" value="to_ready" class="btn btn-sm btn-primary" type="submit">→ Готов</button>
                <button name="batch_action" value="to_completed" class="btn btn-sm btn-secondary" type="submit">→ Выполнен</button>
                <button name="batch_action" value="to_cancelled" class="btn btn-sm btn-outline-danger" type="submit">Отменить</button>
            </div>
        {% endif %}

        <table class="table table-sm table-hover align-middle">
            <thead>
            <tr>
                <th>{% if hasOrders %}<input type="checkbox" id="check-all">{% endif %}</th>
                {% if viewMode == 'week' %}
                    <th>Дата</th>
                {% endif %}
                <th>№</th>
                <th>Клиент</th>
                <th>Сумма</th>
                <th>Статус</th>
            </tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr>
                    <td><input type="checkbox" name="order_ids[]" value="{{ order.id }}" class="order-check"></td>
                    {% if viewMode == 'week' %}
                        <td>{{ order.pickupDate.format('d.m') }}</td>
                    {% endif %}
                    <td>#{{ order.humanNumber }}</td>
                    <td>{{ order.customer.name }}<br><small class="text-muted">{{ order.customer.phone }}</small></td>
                    <td>{{ (order.totalAmount / 100)|number_format(2, ',', ' ') }} ₽</td>
                    <td>
                        <span class="badge rounded-pill text-bg-{{ order.status.badgeType() }}">
                            {{ order.status.label }}
                        </span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ viewMode == 'week' ? 6 : 5 }}" class="text-muted">
                        {% if viewMode == 'week' %}
                            Заказов на эту неделю нет.
                        {% else %}
                            Заказов на этот день нет.
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </form>

    <script>
        document.getElementById('check-all')?.addEventListener('change', function (e) {
            document.querySelectorAll('.order-check').forEach(cb => cb.checked = e.target.checked);
        });
    </script>
{% endblock %}
