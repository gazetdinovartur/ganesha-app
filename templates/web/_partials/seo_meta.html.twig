{%- set seo_page_title = seo_title -%}
{%- set seo_page_description = seo_description|default(site_seo.defaultDescription) -%}
{%- set seo_page_robots = seo_robots|default('index,follow') -%}
{%- set seo_page_type = seo_type|default('website') -%}
{%- set seo_canonical = site_seo.canonicalUrl -%}
{%- set seo_og_image = site_seo.ogImageUrl -%}

<meta name="description" content="{{ seo_page_description|e('html_attr') }}">
<meta name="robots" content="{{ seo_page_robots|e('html_attr') }}">
<link rel="canonical" href="{{ seo_canonical|e('html_attr') }}">

<meta property="og:locale" content="{{ site_seo.locale|replace({'_': '-'})|e('html_attr') }}">
<meta property="og:type" content="{{ seo_page_type|e('html_attr') }}">
<meta property="og:site_name" content="{{ site_seo.siteName|e('html_attr') }}">
<meta property="og:title" content="{{ seo_page_title|e('html_attr') }}">
<meta property="og:description" content="{{ seo_page_description|e('html_attr') }}">
<meta property="og:url" content="{{ seo_canonical|e('html_attr') }}">
<meta property="og:image" content="{{ seo_og_image|e('html_attr') }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site_seo.siteName }} — вегетарианское питание, Екатеринбург">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_page_title|e('html_attr') }}">
<meta name="twitter:description" content="{{ seo_page_description|e('html_attr') }}">
<meta name="twitter:image" content="{{ seo_og_image|e('html_attr') }}">
<meta name="twitter:image:alt" content="{{ site_seo.siteName }} — вегетарианское питание, Екатеринбург">

<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/seo/favicon-32x32.png') }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/seo/favicon-16x16.png') }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/seo/apple-touch-icon.png') }}">
<link rel="manifest" href="{{ asset('site.webmanifest') }}">

<script type="application/ld+json">{{ site_seo.structuredDataJson|raw }}</script>
