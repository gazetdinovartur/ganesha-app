{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Меню · {{ menuDay.date.format('d.m.Y') }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_menu_week') }}" class="btn btn-secondary btn-sm">← К неделе</a>
{% endblock %}

{% block main %}
    {{ form_start(form) }}
        <div class="row mb-3">
            <div class="col-md-3">{{ form_row(form.date) }}</div>
            <div class="col-md-3">{{ form_row(form.isPublished) }}</div>
            <div class="col-md-6">{{ form_row(form.note) }}</div>
        </div>

        <h2 class="h5 mt-4">Блюда дня</h2>
        <div id="dishes-holder" data-prototype="{{ form_widget(form.dishes.vars.prototype)|e('html_attr') }}">
            {% for dishForm in form.dishes %}
                <div class="card mb-2 dish-entry">
                    <div class="card-body row g-2">
                        <div class="col-md-4">{{ form_row(dishForm.dish) }}</div>
                        <div class="col-md-2">{{ form_row(dishForm.priceOverrideRub) }}</div>
                        <div class="col-md-2">{{ form_row(dishForm.sortOrder) }}</div>
                        <div class="col-md-2">{{ form_row(dishForm.isAvailable) }}</div>
                        <div class="col-md-2 d-flex align-items-end pb-3">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-dish">Удалить</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="add-dish-row">+ Блюдо</button>

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Сохранить</button>
        </div>
    {{ form_end(form) }}

    <script>
        (function () {
            const holder = document.getElementById('dishes-holder');
            const addBtn = document.getElementById('add-dish-row');
            if (!holder || !addBtn) return;

            let index = holder.querySelectorAll('.dish-entry').length;

            addBtn.addEventListener('click', function () {
                const html = holder.dataset.prototype.replace(/__name__/g, String(index));
                const wrapper = document.createElement('div');
                wrapper.className = 'card mb-2 dish-entry';
                wrapper.innerHTML = '<div class="card-body row g-2">' + html +
                    '<div class="col-md-2 d-flex align-items-end pb-3">' +
                    '<button type="button" class="btn btn-outline-danger btn-sm remove-dish">Удалить</button></div></div>';
                holder.appendChild(wrapper);
                index++;
            });

            holder.addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-dish')) {
                    e.target.closest('.dish-entry')?.remove();
                }
            });
        })();
    </script>
{% endblock %}
