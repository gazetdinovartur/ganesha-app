{% extends 'web/layout.html.twig' %}

{% block title %}О нас · Ganesha{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-lg-8">
                <section class="site-hero pt-0">
                    <h1>О нас</h1>
                    <p>Ganesha — регулярное вегетарианское питание с самовывозом в центре йоги «Хануман» в Екатеринбурге.</p>
                </section>

                <div class="site-panel mb-4">
                    <h2 class="h5 mb-3">Как заказать</h2>
                    <ol class="site-steps">
                        <li>Выберите день и блюда в <a href="{{ path('web_home') }}">меню</a>.</li>
                        <li>Оформите заказ и оплатите по QR или реквизитам.</li>
                        <li>Заберите заказ в указанное время в точке выдачи.</li>
                    </ol>
                </div>

                <div class="site-panel mb-4">
                    <h2 class="h5 mb-3">Сроки заказа</h2>
                    <p class="mb-0">Заказ на день выдачи принимается до <strong>{{ cutoff_hour }}:00</strong> предыдущего дня (время Екатеринбурга). Меню публикуется на 7 дней вперёд.</p>
                </div>

                {% if pickup_points is not empty %}
                    <div class="site-panel">
                        <h2 class="h5 mb-3">Самовывоз</h2>
                        {% for point in pickup_points %}
                            <div class="{% if not loop.last %}mb-3 pb-3 border-bottom{% endif %}">
                                <strong>{{ point.name }}</strong>
                                <div class="text-muted">{{ point.address }}</div>
                                <div>Часы выдачи: {{ point.pickupHours }}</div>
                                {% if point.description %}
                                    <div class="small mt-1">{{ point.description }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
