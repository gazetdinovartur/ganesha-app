# Скопируй в .env.local и заполни секреты. Этот файл можно коммитить.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_random_string
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Локально с Docker: порт 3307 на хосте
DATABASE_URL="mysql://food:food@127.0.0.1:3307/food?serverVersion=8.0&charset=utf8mb4"
# Внутри docker compose (php-контейнер):
# DATABASE_URL="mysql://food:food@mysql:3306/food?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
APP_TIMEZONE=Asia/Yekaterinburg
ORDER_CUTOFF_HOUR=18
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

VK_GROUP_TOKEN=
VK_CONFIRMATION_SECRET=

PAYMENT_QR_URL=
PAYMENT_CARD=
PAYMENT_WEBHOOK_SECRET=change_me
###< app ###
