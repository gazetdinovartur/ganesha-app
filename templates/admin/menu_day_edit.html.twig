{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form 'form/admin_theme.html.twig' %}

{% set weekdayNames = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'] %}
{% set dayLabel = weekdayNames[menuDay.date.format('w')] ~ ', ' ~ menuDay.date.format('d.m.Y') %}

{% block page_title %}Меню · {{ weekdayNames[menuDay.date.format('w')] }}, {{ menuDay.date.format('d.m.Y') }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_menu_week') }}" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>К неделе
    </a>
{% endblock %}

{% block main %}
    {% include 'admin/_validation_summary.html.twig' with {form: form} %}

    {{ form_start(form, {attr: {class: 'ganesha-menu-day-form', novalidate: 'novalidate'}}) }}

    <div class="card ganesha-card mb-4">
        <div class="card-header day-card-header">
            <span>День · {{ dayLabel }}</span>
            <div class="day-publish-toggle">
                <div class="form-check form-switch mb-0">
                    {{ form_widget(form.isPublished) }}
                    {{ form_label(form.isPublished, null, {label_attr: {class: 'form-check-label mb-0'}}) }}
                </div>
                {{ form_errors(form.isPublished) }}
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    {{ form_row(form.note) }}
                </div>
            </div>
        </div>
    </div>

    <div class="card ganesha-card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="fa-solid fa-utensils me-1"></i>Блюда в меню</span>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-primary" id="add-dish-row">
                    <i class="fa-solid fa-plus me-1"></i>Добавить блюдо в день
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table menu-dishes-table mb-0">
                    <thead>
                    <tr>
                        <th style="width: 2.5rem"></th>
                        <th style="min-width: 18rem">Блюдо</th>
                        <th style="width: 8rem">Цена дня</th>
                        <th style="width: 5rem">Порядок</th>
                        <th style="width: 4rem"></th>
                    </tr>
                    </thead>
                    <tbody id="dishes-holder"
                           data-collection-holder
                           data-collection-row=".dish-entry"
                           data-collection-add="#add-dish-row"
                           data-prototype="{{ include('admin/_menu_day_dish_row.html.twig', {dishForm: form.dishes.vars.prototype})|e('html_attr') }}">
                    {% for dishForm in form.dishes %}
                        {% include 'admin/_menu_day_dish_row.html.twig' with {dishForm: dishForm} %}
                    {% else %}
                        <tr class="menu-dishes-empty-row">
                            <td colspan="5" class="menu-dishes-empty">
                                Пока нет блюд. Нажмите «Добавить блюдо в день».
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">
            <i class="fa-solid fa-check me-1"></i>Сохранить меню
        </button>
        <a href="{{ path('admin_menu_week') }}" class="btn btn-outline-secondary">Отмена</a>
    </div>

    {{ form_widget(form.date, {attr: {class: 'd-none', tabindex: '-1', 'aria-hidden': 'true'}}) }}
    {{ form_widget(form._token) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
